# Pooled (transaction-mode) URL used by the app at runtime
DATABASE_URL=postgres://user:pass@host:6543/nexus
# Direct (non-pooled) URL used ONLY for drizzle-kit migrations / seed
DIRECT_DATABASE_URL=postgres://user:pass@host:5432/nexus
AUTH_SECRET=replace-with-32+-char-random-string
# Bearer secret protecting /api/cron/* (Vercel Cron sends it automatically)
CRON_SECRET=replace-with-32+-char-random-string
BUSINESS_TIMEZONE=America/New_York
DB_POOL_MAX=3
